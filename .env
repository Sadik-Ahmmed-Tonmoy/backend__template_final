# ========================================
# ENVIRONMENT CONFIGURATION
# Copy this to .env and fill in your values
# NEVER commit real secrets to version control
# ========================================

NODE_ENV=development
PORT=5000

# ---- Database ----
DATABASE_URL= "mongodb+srv://sadik:rwneEX7oWsRqLvJYs@cluster0.lw1wxb4.mongodb.net/backend_template_final?retryWrites=true&w=majority&appName=Cluster0"


# ---- App Identity ----
APP_NAME="My App"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=1234567899

# ---- Security ----
BCRYPT_SALT_ROUNDS=12

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed origins (no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- App URLs ----
BASE_URL_CLIENT=http://localhost:3000
BASE_URL_SERVER=http://localhost:5000

# ---- Email (Nodemailer / Gmail App Password) ----
NODE_MAILER_EMAIL=
NODE_MAILER_PASSWORD=

# ---- S3-Compatible Storage (DigitalOcean Spaces / MinIO / AWS S3) ----
DO_SPACE_ENDPOINT=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_BUCKET=

# ---- Stripe ----
STRIPE_PUBLISHED_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Firebase Admin SDK ----
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# ---- SSL Commerz (Bangladesh Payment Gateway) ----
# Sandbox: store_id=testbox, store_pass=testbox
# Production: replace with live credentials from sslcommerz.com
SSL_STORE_ID=testbox
SSL_STORE_PASS=testbox
SSL_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_CURRENCY=BDT
